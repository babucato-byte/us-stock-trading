{
  "conservative_trend": {
    "description": "Large, liquid names in confirmed trend.",
    "scan_limit": 1000,
    "top_alert_count": 5,
    "avg_volume_window": 20,
    "rsi_period": 14,
    "filters": [
      {"field": "price", "operator": ">=", "value": 10},
      {"field": "avg_dollar_volume", "operator": ">=", "value": 50000000},
      {"field": "rsi", "operator": "between", "min": 42, "max": 62},
      {"field": "volume_ratio", "operator": ">=", "value": 1.3},
      {"field": "score", "operator": ">=", "value": 70},
      {"field": "smart_money_score", "operator": ">=", "value": 50},
      {"field": "above_ma200", "operator": "==", "value": true}
    ]
  },
  "smart_money": {
    "description": "Prioritizes unusual volume and smart-money score.",
    "scan_limit": 1200,
    "top_alert_count": 7,
    "avg_volume_window": 20,
