{
  "conservative_trend": {
    "description": "Large, liquid names in confirmed trend.",
    "scan_limit": 1000,
    "top_alert_count": 5,
    "avg_volume_window": 20,
    "rsi_period": 14,
    "filters": [
      {"field": "price", "operator": ">=", "value": 10},
      {"field": "avg_dollar_volume", "operator": ">=", "value": 50000000},
      {"field": "rsi", "operator": "between", "min": 42, "max": 62},
      {"field": "volume_ratio", "operator": ">=", "value": 1.3},
      {"field": "score", "operator": ">=", "value": 70},
      {"field": "smart_money_score", "operator": ">=", "value": 50},
      {"field": "above_ma200", "operator": "==", "value": true}
    ]
  },
  "smart_money": {
    "description": "Prioritizes unusual volume and smart-money score.",
    "scan_limit": 1200,
    "top_alert_count": 7,
    "avg_volume_window": 20,
    "rsi_period": 14,
    "filters": [
      {"field": "price", "operator": ">=", "value": 5},
      {"field": "avg_dollar_volume", "operator": ">=", "value": 30000000},
      {"field": "rsi", "operator": "between", "min": 38, "max": 68},
      {"field": "volume_ratio", "operator": ">=", "value": 1.8},
      {"field": "score", "operator": ">=", "value": 70},
      {"field": "smart_money_score", "operator": ">=", "value": 70},
      {"field": "above_ma200", "operator": "==", "value": true}
    ]
  },
  "momentum": {
    "description": "Broader momentum screen with looser RSI range.",
    "scan_limit": 1000,
    "top_alert_count": 10,
    "avg_volume_window": 20,
    "rsi_period": 14,
    "filters": [
      {"field": "price", "operator": ">=", "value": 3},
      {"field": "avg_dollar_volume", "operator": ">=", "value": 15000000},
      {"field": "rsi", "operator": "between", "min": 45, "max": 75},
      {"field": "volume_ratio", "operator": ">=", "value": 1.5},
      {"field": "score", "operator": ">=", "value": 70},
      {"field": "smart_money_score", "operator": ">=", "value": 50}
    ]
  },
  "paper_safe": {
    "description": "Default paper-trading profile.",
    "scan_limit": 800,
    "top_alert_count": 5,
    "avg_volume_window": 20,
    "rsi_period": 14,
    "filters": [
      {"field": "price", "operator": ">=", "value": 5},
      {"field": "avg_dollar_volume", "operator": ">=", "value": 20000000},
      {"field": "rsi", "operator": "between", "min": 40, "max": 65},
      {"field": "volume_ratio", "operator": ">=", "value": 1.2},
      {"field": "score", "operator": ">=", "value": 70},
      {"field": "smart_money_score", "operator": ">=", "value": 50},
      {"field": "above_ma200", "operator": "==", "value": true}
    ]
  },
  "smoke_test": {
    "description": "Small loose scan for quickly verifying scanner and technical-filter plumbing.",
    "scan_limit": 30,
    "top_alert_count": 5,
    "avg_volume_window": 20,
    "rsi_period": 14,
    "filters": [
      {"field": "price", "operator": ">=", "value": 0},
      {"field": "avg_dollar_volume", "operator": ">=", "value": 0},
      {"field": "rsi", "operator": "between", "min": 0, "max": 100},
      {"field": "volume_ratio", "operator": ">=", "value": 0},
      {"field": "score", "operator": ">=", "value": 0},
      {"field": "smart_money_score", "operator": ">=", "value": 0}
    ]
  },
  "premarket_momentum_score": {
    "description": "Standalone score scanner preset. Records premarket momentum candidates only.",
    "scan_limit": 30,
    "output_file": "logs/score_scanner_candidates.csv",
    "paper_trade_log": "logs/paper_trades_score_scanner.csv",
    "min_score": 70,
    "required": {
      "price_above_vwap": true,
      "ema9_above_ema21": true,
      "volume_multiple_min": 3.0,
      "premarket_gain_pct_min": 10.0
    },
    "bonus": {
      "break_prev_high": 20,
      "adx_gt_25": 10,
      "near_or_break_52w_high": 10
    }
  },
  "live_dry_run": {
    "description": "Strict pre-live dry-run profile. Does not enable live orders.",
    "scan_limit": 1000,
    "top_alert_count": 5,
    "avg_volume_window": 20,
    "rsi_period": 14,
    "filters": [
      {"field": "price", "operator": ">=", "value": 10},
      {"field": "avg_dollar_volume", "operator": ">=", "value": 75000000},
      {"field": "rsi", "operator": "between", "min": 42, "max": 60},
      {"field": "volume_ratio", "operator": ">=", "value": 1.5},
      {"field": "score", "operator": ">=", "value": 70},
      {"field": "smart_money_score", "operator": ">=", "value": 70},
      {"field": "above_ma200", "operator": "==", "value": true}
    ]
