# TRADING_PROJECT_ROOT: leave empty on a dev checkout (repo root is
# auto-detected). Set explicitly on the production server, e.g.
# TRADING_PROJECT_ROOT=/home/ubuntu/trading
TRADING_PROJECT_ROOT=

# TRADING_BASE_DIR / TRADING_PYTHON: used only by daily_pipeline.py. Leave
# empty on a dev checkout; the script falls back to its own file location
# and the current Python interpreter.
TRADING_BASE_DIR=
TRADING_PYTHON=

TRADING_MODE=paper
ENABLE_REAL_TRADING=False
LIVE_DRY_RUN=True

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

SLACK_WEBHOOK_URL=
SLACK_ALERT_WEBHOOK_URL=

AI_ANALYSIS_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_ANALYSIS_LIMIT=10

USE_TECHNICAL_ENTRY_FILTER=true
SCAN_LIMIT=
TECHNICAL_FILTER_MIN_SCORE=5
TECH_FILTER_WEIGHT_PRICE_ABOVE_HMA200=1
TECH_FILTER_WEIGHT_HMA200_RISING=2
TECH_FILTER_WEIGHT_HMA_MACD_BULLISH=1
TECH_FILTER_WEIGHT_MACD_HISTOGRAM_RISING=2
TECH_FILTER_WEIGHT_SQZMOM_GREEN=2
HMA_LONG_LENGTH=200
HMA_MACD_FAST=12
HMA_MACD_SLOW=26
HMA_MACD_SIGNAL=9
SQZMOM_LENGTH=20
SQZMOM_BB_MULT=2.0
SQZMOM_KC_MULT=1.5
