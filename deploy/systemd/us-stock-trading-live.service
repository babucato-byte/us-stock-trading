# CODEX-049: the LIVE buy-entry service.
#
# INSTALLED BUT DELIBERATELY NOT ENABLED. scripts/install_oracle_services.sh
# never runs `systemctl enable` on this unit, and the preflight below
# refuses to start it while the read-only posture is in force -- so
# starting it requires BOTH an explicit operator `systemctl start` AND a
# reviewed change to /etc/us-stock-trading/live-readonly.env. That is the
# intended two-key arrangement for the first real order.
#
# Enabling live trading is out of scope for the initial deployment; see
# docs/deployment/ORACLE_KIS_MIGRATION_RUNBOOK.md.
[Unit]
Description=US Stock Trading -- KIS live buy-entry cycle (DISABLED by default)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=trading
WorkingDirectory=/home/ubuntu/trading-release
EnvironmentFile=/etc/us-stock-trading/live-readonly.env
ExecStartPre=/home/ubuntu/trading-release/venv/bin/python /home/ubuntu/trading-release/scripts/preflight_kis_live.py
ExecStart=/home/ubuntu/trading-release/venv/bin/python /home/ubuntu/trading-release/scripts/run_live_buy_entry.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/ubuntu/trading-release /var/log/us-stock-trading

[Install]
WantedBy=multi-user.target
