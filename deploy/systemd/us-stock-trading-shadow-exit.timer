# CODEX-049: periodic trigger for us-stock-trading-shadow-exit.service.
[Unit]
Description=Run US Stock Trading KIS Shadow exit evaluation every 2 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=2min
AccuracySec=15s
Persistent=true
Unit=us-stock-trading-shadow-exit.service

[Install]
WantedBy=timers.target
