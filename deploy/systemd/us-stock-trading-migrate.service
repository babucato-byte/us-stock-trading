# CODEX-049: US Stock Trading -- state-store schema migration
#
# Paths assume the deployment layout the Oracle runbook describes
# (/home/ubuntu/trading-release). Adjust WorkingDirectory / ExecStart /
# ReadWritePaths together if the release directory differs.
# Every other unit Requires= this one, so no service can ever run
# against a database that is behind the deployed code.
[Unit]
Description=US Stock Trading -- state-store schema migration
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/ubuntu/trading-release/venv/bin/python
ConditionPathExists=/etc/us-stock-trading/live-readonly.env
ConditionPathExists=/home/ubuntu/trading-release/scripts/run_migrations.py

[Service]
Type=oneshot
User=ubuntu
Group=trading
WorkingDirectory=/home/ubuntu/trading-release
EnvironmentFile=/etc/us-stock-trading/live-readonly.env
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/ubuntu/trading-release /var/log/us-stock-trading
ExecStart=/home/ubuntu/trading-release/venv/bin/python /home/ubuntu/trading-release/scripts/run_migrations.py

[Install]
WantedBy=multi-user.target
