# CODEX-049: US Stock Trading -- KIS Shadow exit evaluation (places no orders)
#
# Paths assume the deployment layout the Oracle runbook describes
# (/home/ubuntu/trading-release). Adjust WorkingDirectory / ExecStart /
# ReadWritePaths together if the release directory differs.
# Evaluates stop-loss/take-profit/time-stop/EOD exit conditions on
# real held positions using positions.lifecycle.decide_exit() -- the
# same pure function check_and_manage() dispatches on -- and records
# what WOULD happen. It never calls check_and_manage(), so it cannot
# submit an exit order.
[Unit]
Description=US Stock Trading -- KIS Shadow exit evaluation (places no orders)
After=network-online.target us-stock-trading-migrate.service us-stock-trading-reconcile.service
Wants=network-online.target
Requires=us-stock-trading-migrate.service us-stock-trading-reconcile.service
ConditionPathExists=/home/ubuntu/trading-release/venv/bin/python
ConditionPathExists=/etc/us-stock-trading/live-readonly.env
ConditionPathExists=/home/ubuntu/trading-release/scripts/run_shadow_exit_evaluation.py

[Service]
Type=oneshot
User=ubuntu
Group=trading
WorkingDirectory=/home/ubuntu/trading-release
EnvironmentFile=/etc/us-stock-trading/live-readonly.env
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/ubuntu/trading-release /var/log/us-stock-trading
ExecStartPre=/home/ubuntu/trading-release/venv/bin/python /home/ubuntu/trading-release/scripts/preflight_kis_live.py
ExecStart=/home/ubuntu/trading-release/venv/bin/python /home/ubuntu/trading-release/scripts/run_shadow_exit_evaluation.py

[Install]
WantedBy=multi-user.target
