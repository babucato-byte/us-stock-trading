# CODEX-049: US Stock Trading -- KIS Shadow exit evaluation (places no orders)
#
# LOW: paths are TEMPLATED, not hardcoded. scripts/install_oracle_
# services.sh substitutes @TRADING_RELEASE_ROOT@, @TRADING_SHARED_ROOT@,
# @TRADING_ENV_FILE@ and @TRADING_LOG_DIR@ at install time, so one unit
# file fits any release layout. A unit installed with an unsubstituted
# placeholder fails its ConditionPathExists rather than running against
# a wrong path.
# Evaluates stop-loss/take-profit/time-stop/EOD exit conditions on
# real held positions using positions.lifecycle.decide_exit() -- the
# same pure function check_and_manage() dispatches on -- and records
# what WOULD happen. It never calls check_and_manage(), so it cannot
# submit an exit order.
[Unit]
Description=US Stock Trading -- KIS Shadow exit evaluation (places no orders)
After=network-online.target us-stock-trading-migrate.service us-stock-trading-reconcile.service
Wants=network-online.target
Requires=us-stock-trading-migrate.service us-stock-trading-reconcile.service
ConditionPathExists=@TRADING_RELEASE_ROOT@/venv/bin/python
ConditionPathExists=@TRADING_ENV_FILE@
ConditionPathExists=@TRADING_RELEASE_ROOT@/scripts/run_shadow_exit_evaluation.py

[Service]
Type=oneshot
User=ubuntu
Group=trading
WorkingDirectory=@TRADING_RELEASE_ROOT@
EnvironmentFile=@TRADING_ENV_FILE@
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=@TRADING_RELEASE_ROOT@ @TRADING_SHARED_ROOT@ @TRADING_LOG_DIR@
ExecStartPre=@TRADING_RELEASE_ROOT@/venv/bin/python @TRADING_RELEASE_ROOT@/scripts/preflight_kis_live.py
ExecStart=@TRADING_RELEASE_ROOT@/venv/bin/python @TRADING_RELEASE_ROOT@/scripts/run_shadow_exit_evaluation.py

[Install]
WantedBy=multi-user.target
