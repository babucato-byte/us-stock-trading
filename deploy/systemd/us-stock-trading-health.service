# CODEX-049: US Stock Trading -- durable-state health report
#
# Paths assume the deployment layout the Oracle runbook describes
# (/home/ubuntu/trading-release). Adjust WorkingDirectory / ExecStart /
# ReadWritePaths together if the release directory differs.
# Makes no KIS call at all: reports on schema version, reconciliation
# freshness, UNKNOWN orders, shadow-audit integrity, log corruption
# and whether the live unit is still disabled. Exits 2 when unhealthy.
[Unit]
Description=US Stock Trading -- durable-state health report
After=network-online.target us-stock-trading-migrate.service
Wants=network-online.target
Requires=us-stock-trading-migrate.service
ConditionPathExists=/home/ubuntu/trading-release/venv/bin/python
ConditionPathExists=/etc/us-stock-trading/live-readonly.env
ConditionPathExists=/home/ubuntu/trading-release/scripts/run_health_report.py

[Service]
Type=oneshot
User=ubuntu
Group=trading
WorkingDirectory=/home/ubuntu/trading-release
EnvironmentFile=/etc/us-stock-trading/live-readonly.env
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/ubuntu/trading-release /var/log/us-stock-trading
ExecStart=/home/ubuntu/trading-release/venv/bin/python /home/ubuntu/trading-release/scripts/run_health_report.py

[Install]
WantedBy=multi-user.target
