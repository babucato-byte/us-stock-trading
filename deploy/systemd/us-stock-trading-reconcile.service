# CODEX-049: read-only reconciliation service.
#
# Compares internal state against KIS's own positions/open orders/fills,
# resolves UNKNOWN orders through the compare-and-set repository, records
# the durable reconciliation result, and applies Shadow audit retention.
# Calls only KIS read endpoints -- never submit_order()/cancel_order().
[Unit]
Description=US Stock Trading -- KIS reconciliation (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=trading
WorkingDirectory=/home/ubuntu/trading-release
EnvironmentFile=/etc/us-stock-trading/live-readonly.env
ExecStartPre=/home/ubuntu/trading-release/venv/bin/python /home/ubuntu/trading-release/scripts/preflight_kis_live.py
ExecStart=/home/ubuntu/trading-release/venv/bin/python /home/ubuntu/trading-release/scripts/run_reconciliation.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/ubuntu/trading-release /var/log/us-stock-trading

[Install]
WantedBy=multi-user.target
